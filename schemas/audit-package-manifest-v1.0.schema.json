{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwfi.invalid/schemas/audit-package-manifest-v1.0.schema.json",
  "title": "IWFI Offline Audit Package Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "reconstruction_manifest_hash",
    "canonicalization_version",
    "artifacts",
    "manifest_hash_algorithm",
    "manifest_hash"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "reconstruction_manifest_hash": {
      "$ref": "#/$defs/hash"
    },
    "canonicalization_version": {
      "const": "IWFI-JSON-C14N-1"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "manifest_hash_algorithm": {
      "const": "SHA-256"
    },
    "manifest_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "media_type",
        "size_bytes",
        "hash_algorithm",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
