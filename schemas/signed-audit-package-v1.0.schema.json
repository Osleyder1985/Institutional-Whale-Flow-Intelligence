{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwfi.local/schemas/signed-audit-package-v1.0.schema.json",
  "title": "IWFI Detached Audit Package Signature v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signature_envelope_version",
    "artifact_type",
    "signature_algorithm",
    "canonicalization_version",
    "archive_media_type",
    "archive_size_bytes",
    "archive_sha256",
    "issued_at_utc",
    "key_fingerprint_sha256",
    "signature_hex"
  ],
  "properties": {
    "signature_envelope_version": {"const": "1.0.0"},
    "artifact_type": {"const": "IWFI_AUDIT_PACKAGE_ZIP"},
    "signature_algorithm": {"const": "Ed25519"},
    "canonicalization_version": {"const": "IWFI-JSON-C14N-1"},
    "archive_media_type": {"const": "application/zip"},
    "archive_size_bytes": {"type": "integer", "minimum": 0},
    "archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "key_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signature_hex": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
  }
}
