{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwfi.invalid/schemas/forecast/v1/forecast.schema.json",
  "title": "IWFI Forecast v1",
  "description": "Immutable point-in-time forecast. Synthetic examples are not market evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","forecast_id","status","asset","market","time","target_definition","prediction","data_quality","evidence","provenance"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "forecast_id": {"type":"string","minLength":1},
    "supersedes_forecast_id": {"type":["string","null"]},
    "status": {"enum":["ISSUED","ABSTAINED"]},
    "abstention": {"type":["object","null"],"additionalProperties":false,"required":["reason_code","explanation"],"properties":{"reason_code":{"enum":["INSUFFICIENT_DATA","STALE_DATA","DATA_QUALITY_FAILURE","OUT_OF_DISTRIBUTION","MODEL_NOT_VALIDATED","MODEL_UNAVAILABLE","UNSUPPORTED_ASSET_OR_HORIZON","OTHER"]},"explanation":{"type":"string","minLength":1}}},
    "asset": {"type":"object","additionalProperties":false,"required":["symbol","asset_id","network"],"properties":{"symbol":{"type":"string","minLength":1},"asset_id":{"type":"string","minLength":1},"network":{"type":"string","minLength":1}}},
    "market": {"type":"object","additionalProperties":false,"required":["market_type","instrument","venue","quote_currency"],"properties":{"market_type":{"enum":["SPOT","PERPETUAL","FUTURE","INDEX","REFERENCE"]},"instrument":{"type":"string","minLength":1},"venue":{"type":"string","minLength":1},"quote_currency":{"type":"string","minLength":1}}},
    "time": {"type":"object","additionalProperties":false,"required":["issued_at","as_of_time","data_cutoff_time","horizon_start","horizon_end"],"properties":{"issued_at":{"type":"string","format":"date-time"},"as_of_time":{"type":"string","format":"date-time"},"data_cutoff_time":{"type":"string","format":"date-time"},"horizon_start":{"type":"string","format":"date-time"},"horizon_end":{"type":"string","format":"date-time"},"timezone":{"const":"UTC"}}},
    "target_definition": {"type":"object","additionalProperties":false,"required":["target_id","version","reference_price","direction_method","magnitude_method"],"properties":{"target_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"reference_price":{"type":"object","additionalProperties":false,"required":["value","currency","observed_at","source_ref"],"properties":{"value":{"type":"number","exclusiveMinimum":0},"currency":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"source_ref":{"type":"string","minLength":1}}},"direction_method":{"type":"string","minLength":1},"magnitude_method":{"type":"string","minLength":1},"sideways_band":{"type":["object","null"],"additionalProperties":false,"required":["lower_return_pct","upper_return_pct"],"properties":{"lower_return_pct":{"type":"number","maximum":0},"upper_return_pct":{"type":"number","minimum":0}}}}},
    "prediction": {"type":"object","additionalProperties":false,"required":["direction","magnitude","price_targets","price_zones","time_to_target","scenario_probabilities","uncertainty"],"properties":{
      "direction":{"enum":["BULLISH","BEARISH","SIDEWAYS","UNDETERMINED"]},
      "magnitude":{"type":"object","additionalProperties":false,"required":["status","unit","reference","estimate","interval"],"properties":{"status":{"enum":["ESTIMATED","NOT_QUANTIFIED"]},"unit":{"enum":["RETURN_PCT","PRICE_DELTA"]},"reference":{"type":"string","minLength":1},"estimate":{"type":["number","null"]},"interval":{"type":["object","null"],"additionalProperties":false,"required":["lower","upper","coverage_level"],"properties":{"lower":{"type":"number"},"upper":{"type":"number"},"coverage_level":{"type":["number","null"],"minimum":0,"maximum":1}}}}},
      "price_targets":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["target_id","kind","lower_price","upper_price","currency","method","valid_from","valid_until","status"],"properties":{"target_id":{"type":"string","minLength":1},"kind":{"enum":["PRIMARY","ALTERNATIVE","INVALIDATION"]},"lower_price":{"type":["number","null"],"exclusiveMinimum":0},"upper_price":{"type":["number","null"],"exclusiveMinimum":0},"currency":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"status":{"enum":["ESTIMATED","NOT_ESTIMABLE"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},
      "price_zones":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["zone_id","kind","lower_price","upper_price","currency","method","valid_from","valid_until","probability_status","probability","calibration_ref"],"properties":{"zone_id":{"type":"string","minLength":1},"kind":{"enum":["SUPPORT","RESISTANCE","REACTION","PATH","INVALIDATION"]},"lower_price":{"type":"number","exclusiveMinimum":0},"upper_price":{"type":"number","exclusiveMinimum":0},"currency":{"type":"string","minLength":1},"method":{"type":"string","minLength":1},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"probability_status":{"enum":["CALIBRATED","NOT_CALIBRATED","NOT_QUANTIFIED"]},"probability":{"type":["number","null"],"minimum":0,"maximum":1},"calibration_ref":{"type":["string","null"]},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},
      "time_to_target":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["target_ref","event_definition","status","lower_seconds","upper_seconds","distribution_ref"],"properties":{"target_ref":{"type":"string","minLength":1},"event_definition":{"enum":["FIRST_TOUCH","CLOSE_BEYOND","CONFIRMED_BREAKOUT","OTHER"]},"status":{"enum":["ESTIMATED","NOT_ESTIMABLE"]},"lower_seconds":{"type":["integer","null"],"minimum":0},"upper_seconds":{"type":["integer","null"],"minimum":0},"distribution_ref":{"type":["string","null"]},"notes":{"type":["string","null"]}}}},
      "scenario_probabilities":{"type":"object","additionalProperties":false,"required":["status","bullish","bearish","sideways"],"properties":{"status":{"enum":["CALIBRATED","NOT_CALIBRATED","NOT_QUANTIFIED"]},"bullish":{"type":["number","null"],"minimum":0,"maximum":1},"bearish":{"type":["number","null"],"minimum":0,"maximum":1},"sideways":{"type":["number","null"],"minimum":0,"maximum":1},"calibration_ref":{"type":["string","null"]}}},
      "uncertainty":{"type":"object","additionalProperties":false,"required":["status","summary","limitations"],"properties":{"status":{"enum":["QUANTIFIED","PARTIALLY_QUANTIFIED","NOT_QUANTIFIED"]},"summary":{"type":"string","minLength":1},"limitations":{"type":"array","items":{"type":"string"}}}}
    }},
    "data_quality":{"type":"object","additionalProperties":false,"required":["status","coverage_ratio","freshness_status","missing_inputs"],"properties":{"status":{"enum":["PASS","DEGRADED","FAIL"]},"coverage_ratio":{"type":["number","null"],"minimum":0,"maximum":1},"freshness_status":{"enum":["CURRENT","DELAYED","STALE","UNKNOWN"]},"missing_inputs":{"type":"array","items":{"type":"string"}}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["supporting","contrary","alternatives","invalidation_conditions"],"properties":{"supporting":{"type":"array","items":{"$ref":"#/$defs/evidence_link"}},"contrary":{"type":"array","items":{"$ref":"#/$defs/evidence_link"}},"alternatives":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["hypothesis","evidence_refs"],"properties":{"hypothesis":{"type":"string","minLength":1},"evidence_refs":{"type":"array","items":{"type":"string"}}}}},"invalidation_conditions":{"type":"array","items":{"type":"string"}}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["model_id","model_version","feature_set_version","code_version","config_version","dataset_snapshot_ref","evaluation_protocol_version","source_refs"],"properties":{"model_id":{"type":"string","minLength":1},"model_version":{"type":"string","minLength":1},"calibration_version":{"type":["string","null"]},"feature_set_version":{"type":"string","minLength":1},"code_version":{"type":"string","minLength":1},"config_version":{"type":"string","minLength":1},"dataset_snapshot_ref":{"type":"string","minLength":1},"evaluation_protocol_version":{"type":"string","minLength":1},"source_refs":{"type":"array","items":{"type":"string"}}}}
  },
  "$defs":{"evidence_link":{"type":"object","additionalProperties":false,"required":["evidence_ref","role","observed_at","known_at"],"properties":{"evidence_ref":{"type":"string","minLength":1},"role":{"enum":["SUPPORTS","CONTRADICTS","CONTEXT"]},"observed_at":{"type":"string","format":"date-time"},"known_at":{"type":"string","format":"date-time"}}}},
  "allOf":[
    {"if":{"properties":{"status":{"const":"ISSUED"}}},"then":{"required":["abstention"],"properties":{"abstention":{"type":"null"},"prediction":{"properties":{"direction":{"not":{"const":"UNDETERMINED"}}}}}}},
    {"if":{"properties":{"status":{"const":"ABSTAINED"}}},"then":{"required":["abstention"],"properties":{"abstention":{"type":"object"},"prediction":{"properties":{"direction":{"const":"UNDETERMINED"}}}}}}
  ]
}