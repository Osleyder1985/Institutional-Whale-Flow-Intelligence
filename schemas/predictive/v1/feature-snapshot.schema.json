{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iwfi.invalid/schemas/predictive/v1/feature-snapshot.schema.json",
  "title": "IWFI FeatureSnapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "status",
    "asset",
    "market",
    "origin_time",
    "data_cutoff_time",
    "created_at",
    "feature_set_version",
    "source_observations",
    "features",
    "quality",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "READY",
        "DEGRADED",
        "ABSTAINED"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "symbol",
        "network"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_type",
        "instrument",
        "venue",
        "quote_currency"
      ],
      "properties": {
        "market_type": {
          "enum": [
            "SPOT",
            "PERPETUAL",
            "FUTURE",
            "INDEX",
            "REFERENCE"
          ]
        },
        "instrument": {
          "type": "string",
          "minLength": 1
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "quote_currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "origin_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "data_cutoff_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "feature_set_version": {
      "type": "string",
      "minLength": 1
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "event_time",
          "known_at",
          "ingested_at",
          "available_at",
          "revision_id"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "event_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "known_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "revision_id": {
            "type": "string",
            "minLength": 1
          },
          "supersedes_source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "definition_version",
          "status",
          "value",
          "unit",
          "window_start",
          "window_end",
          "computed_at",
          "source_refs",
          "coverage_ratio",
          "missing_reason"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "definition_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "AVAILABLE",
              "MISSING",
              "STALE",
              "INVALID"
            ]
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "window_start": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "computed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coverage_ratio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "coverage_ratio",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "DEGRADED",
            "FAIL"
          ]
        },
        "coverage_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_code_version",
        "config_version",
        "snapshot_hash",
        "source_policy_version"
      ],
      "properties": {
        "feature_code_version": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "minLength": 1
        },
        "source_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
