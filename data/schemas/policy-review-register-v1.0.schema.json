{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/iwfi/policy-review-register-v1.0.schema.json",
  "title": "IWFI Policy Review Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_register_version",
    "register_scope",
    "reviewer",
    "reviewed_at_utc",
    "findings"
  ],
  "properties": {
    "review_register_version": {
      "const": "1.0.0"
    },
    "register_scope": {
      "const": "METADATA_AND_REFERENCES_ONLY"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "proposition",
          "conclusion_type",
          "applicability_status",
          "review_state",
          "source",
          "locator"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "conclusion_type": {
            "enum": [
              "OBSERVED_TEXT",
              "INTERPRETATION"
            ]
          },
          "applicability_status": {
            "enum": [
              "NOT_ASSESSED",
              "ASSESSED_APPLICABLE",
              "ASSESSED_NOT_APPLICABLE",
              "UNCERTAIN"
            ]
          },
          "review_state": {
            "enum": [
              "DRAFT",
              "REVIEWED",
              "REVIEW_REQUIRED"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "snapshot_sha256"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "declared_version": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "exact_text"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "document_text",
                  "pdf_page"
                ]
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "exact_text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
